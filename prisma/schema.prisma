generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  DJ
  ORGANIZER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DjProfileStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PostType {
  TEXT
  IMAGE
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum JobStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  NEW_COMMENT
  NEW_REPLY
  NEW_RATING
  NEW_JOB
  JOB_APPLICATION
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  DJ_REGISTRATION // Admin receives this when a DJ registers
}

enum DjType {
  CLUB
  WEDDING
  FESTIVAL
  CORPORATE
  BAR_LOUNGE
  PRIVATE_PARTY
  BIRTHDAY
  CULTURAL_EVENT
}

enum DjPlan {
  FREE
  PREMIUM
}

enum OrganizerType {
  INDIVIDUAL
  COMPANY
  VENUE
  AGENCY
  FESTIVAL
}

enum OrganizerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// ============================================================
// SECTION 1: MVP MODELS
// ============================================================

// ------ GEOGRAPHY ------

model Country {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  code              String             @unique // ISO 3166-1 alpha-2, e.g. "SE"
  cities            City[]
  users             User[]
  djProfiles        DjProfile[]
  organizerProfiles OrganizerProfile[]
  events            Event[]

  @@index([name])
}

model City {
  id                Int                @id @default(autoincrement())
  name              String
  countryId         Int
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  users             User[]
  djProfiles        DjProfile[]
  organizerProfiles OrganizerProfile[]
  events            Event[]

  @@unique([name, countryId])
  @@index([countryId])
}

// ------ USER ------

model User {
  id        String     @id // Must match Supabase Auth user id
  email     String     @unique
  username  String     @unique
  name      String?
  image     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])

  roles            UserRole[]
  djProfile        DjProfile?
  organizerProfile OrganizerProfile?

  posts            Post[]
  postComments     PostComment[]
  postLikes        PostLike[]
  postCommentLikes PostCommentLike[]

  djComments     DjComment[]
  djCommentLikes DjCommentLike[]
  djRatings      DjRating[]

  jobApplications JobApplication[] @relation("ApplicantApplications")
  jobsPosted      Job[]            @relation("OrganizerJobs")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  followers  Follower[] @relation("UserFollowers")
  followings Follower[] @relation("UserFollowings")

  @@index([status])
  @@index([deletedAt])
  @@index([countryId])
  @@index([cityId])
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

// ------ DJ PROFILE ------

// Admin must approve before profile is publicly visible.
// DJs can still edit while PENDING_APPROVAL.
model DjProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stageName  String
  slug       String          @unique // URL-friendly: /djs/[slug]
  avatar     String? // Supabase Storage URL
  coverImage String? // Supabase Storage URL
  bio        String?
  status     DjProfileStatus @default(PENDING_APPROVAL)

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])

  plan         DjPlan  @default(FREE)
  verified     Boolean @default(false)
  featured     Boolean @default(false)
  searchScore  Float   @default(0)
  bookingEmail String?
  bookingPhone String?
  feeMin       Int?
  feeMax       Int?
  feeCurrency  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  genres      DjGenre[]
  djTypes     DjProfileType[]
  socialLinks SocialLink[]
  ratings     DjRating[]
  comments    DjComment[]
  media       Media[]
  events      EventDj[]
  eventsOwned Event[]         @relation("EventOwner")

  @@index([slug])
  @@index([status])
  @@index([plan])
  @@index([featured])
  @@index([searchScore])
  @@index([countryId])
  @@index([cityId])
}

// ------ ORGANIZER PROFILE ------

model OrganizerProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String

  slug          String          @unique // /organizers/[slug]
  organizerType OrganizerType   @default(INDIVIDUAL)
  status        OrganizerStatus @default(ACTIVE)

  bio           String?
  logoUrl       String? // Supabase Storage: org-avatar bucket
  coverImageUrl String? // Supabase Storage: org-cover bucket
  website       String?
  contactEmail  String? // PRIVATE — never rendered publicly
  phone         String?

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  socialLinks OrganizerSocialLink[]
  jobs        Job[]

  @@index([slug])
  @@index([status])
  @@index([organizerType])
  @@index([countryId])
  @@index([cityId])
}

// ------ ORGANIZER SOCIAL LINKS ------

// platform values: "instagram" | "linkedin" | "facebook" | "tiktok" | "youtube" | "website"
model OrganizerSocialLink {
  id                 Int              @id @default(autoincrement())
  organizerProfileId Int
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  platform           String
  url                String

  @@unique([organizerProfileId, platform])
  @@index([organizerProfileId])
}

// ------ GENRES ------

// Admin-managed list of genres
model Genre {
  id       Int       @id @default(autoincrement())
  name     String    @unique // e.g. "Afrobeat", "House", "Amapiano"
  djGenres DjGenre[]

  @@index([name])
}

model DjGenre {
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  genreId     Int
  genre       Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([djProfileId, genreId])
}

model DjProfileType {
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  type        DjType

  @@id([djProfileId, type])
}

// ------ SOCIAL LINKS ------

// platform values: "instagram" | "tiktok" | "youtube" | "spotify" | "soundcloud" | "mixcloud" | "website"
// UI renders icon based on platform string
model SocialLink {
  id          Int       @id @default(autoincrement())
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  platform    String
  url         String

  @@unique([djProfileId, platform])
  @@index([djProfileId])
}

// ------ MEDIA ------

// MVP: IMAGE only. Schema is ready for VIDEO and AUDIO later.
// Supabase Storage bucket: "djscovery-media"
model Media {
  id     Int       @id @default(autoincrement())
  type   MediaType @default(IMAGE)
  url    String // Supabase Storage public URL
  bucket String // Supabase Storage bucket name
  path   String // Supabase Storage path within bucket

  djProfileId Int?
  djProfile   DjProfile? @relation(fields: [djProfileId], references: [id], onDelete: SetNull)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([postId])
  @@index([type])
}

// ------ DJ RATINGS ------

// One rating per user per DJ; user can update but not duplicate
model DjRating {
  id     Int     @id @default(autoincrement())
  rating Int // 1-5
  review String?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, djProfileId])
  @@index([djProfileId])
}

// ------ DJ PROFILE COMMENTS ------

// Allowed roles: FAN, DJ, ORGANIZER
// Self-referencing for replies (parentId)
model DjComment {
  id        Int       @id @default(autoincrement())
  content   String
  deletedAt DateTime?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   DjComment?  @relation("DjCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  DjComment[] @relation("DjCommentReplies")

  likes DjCommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djProfileId])
  @@index([parentId])
  @@index([userId])
}

model DjCommentLike {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId Int
  comment   DjComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ------ COMMUNITY FEED ------

// Only DJs can create posts (enforce in app layer)
model Post {
  id        Int       @id @default(autoincrement())
  type      PostType  @default(TEXT)
  content   String?
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments PostComment[]
  likes    PostLike[]
  media    Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// Self-referencing for replies
model PostComment {
  id        Int       @id @default(autoincrement())
  content   String
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  PostComment[] @relation("PostCommentReplies")

  likes PostCommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostCommentLike {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId Int
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ------ EVENTS ------

// Only DJs create events. Owner DJ controls the event.
model Event {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  image       String? // Supabase Storage URL
  venue       String?
  startDate   DateTime
  endDate     DateTime?
  status      EventStatus @default(DRAFT)
  deletedAt   DateTime?

  ownerDjId Int
  ownerDj   DjProfile @relation("EventOwner", fields: [ownerDjId], references: [id])
  countryId Int?
  country   Country?  @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?     @relation(fields: [cityId], references: [id])

  participants EventDj[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerDjId])
  @@index([status])
  @@index([startDate])
  @@index([countryId])
}

// Junction: multiple DJs per event
model EventDj {
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@id([eventId, djProfileId])
}

// ------ HIRING MARKETPLACE ------

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  budget      Decimal?
  status      JobStatus @default(OPEN)
  deletedAt   DateTime?

  organizerId        String
  organizer          User             @relation("OrganizerJobs", fields: [organizerId], references: [id])
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id])
  organizerProfileId Int

  countryId Int?
  cityId    Int?

  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizerId])
}

model JobApplication {
  id       Int               @id @default(autoincrement())
  status   ApplicationStatus @default(PENDING)
  message  String? // DJ's cover message
  isInvite Boolean           @default(false) // true = organizer invited DJ directly

  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User   @relation("ApplicantApplications", fields: [applicantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
}

// ------ FOLLOWERS ------

model Follower {
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowings", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

// ------ NOTIFICATIONS ------

// Database-only for MVP.
// TODO: Integrate email notifications (e.g. Resend / SendGrid) by adding
//       a background job that reads unread Notification rows and sends emails.
//       Add an `emailSentAt DateTime?` column here when ready.
model Notification {
  id   Int              @id @default(autoincrement())
  type NotificationType
  read Boolean          @default(false)
  data Json? // flexible payload (postId, djProfileId, jobId, etc.)

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // senderId is null for system-generated notifications
  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

// ============================================================
// SECTION 2: PHASE 2 MODELS
// (Schema defined, development deferred)
// ============================================================

// ------ DIRECT MESSAGING ------

enum AttendanceStatus {
  INTERESTED
  GOING
  ATTENDED
}

// Supports DJ <-> Organizer, Fan <-> DJ, DJ <-> DJ
model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id      Int       @id @default(autoincrement())
  content String
  readAt  DateTime?

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ------ EVENT ATTENDANCE ------

model EventAttendance {
  eventId Int
  userId  String
  status  AttendanceStatus

  @@id([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ------ HIRE RECORDS ------

// Created automatically when a JobApplication is ACCEPTED
model Hire {
  id            Int      @id @default(autoincrement())
  applicationId Int      @unique
  agreedRate    Decimal?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

