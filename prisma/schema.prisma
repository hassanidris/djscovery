generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model BookingInquiry {
  id                Int                     @id @default(autoincrement())
  status            BookingInquiryStatus    @default(PENDING)
  eventName         String
  eventDate         DateTime?
  venue             String?
  countryName       String?
  cityName          String?
  crowdSize         Int?
  budgetType        BudgetType              @default(NEGOTIABLE)
  budgetMin         Int?
  budgetMax         Int?
  budgetCurrency    String?                 @db.VarChar(10)
  message           String
  contactReleasedAt DateTime?
  lastRespondedAt   DateTime?
  packageName       String?
  packagePrice      Int?
  packagePriceTo    Int?
  countryId         Int?
  cityId            Int?
  djProfileId       Int
  organizerId       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  userId            String?
  city              City?                   @relation("BookingInquiryCity", fields: [cityId, countryId], references: [id, countryId])
  country           Country?                @relation("BookingInquiryCountry", fields: [countryId], references: [id])
  djProfile         DjProfile               @relation("DjProfileBookingInquiries", fields: [djProfileId], references: [id], onDelete: Cascade)
  organizer         User                    @relation("OrganizerBookingInquiries", fields: [organizerId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id])
  messages          BookingInquiryMessage[]

  @@index([djProfileId, status])
  @@index([organizerId, status])
  @@index([djProfileId, organizerId])
  @@index([createdAt])
}

model BookingInquiryMessage {
  id         Int                           @id @default(autoincrement())
  body       String
  senderRole BookingInquiryParticipantRole
  readAt     DateTime?
  inquiryId  Int
  senderId   String
  createdAt  DateTime                      @default(now())
  inquiry    BookingInquiry                @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender     User                          @relation("BookingInquiryMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model Country {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  code              String             @unique
  bookingInquiries  BookingInquiry[]   @relation("BookingInquiryCountry")
  cities            City[]
  djProfiles        DjProfile[]
  djVenues          DjVenue[]
  events            Event[]
  fanProfiles       FanProfile[]
  gigs              Gig[]
  organizerProfiles OrganizerProfile[]
  users             User[]
  venues            Venue[]

  @@index([name])
}

model City {
  id                Int                @id @default(autoincrement())
  name              String
  countryId         Int
  bookingInquiries  BookingInquiry[]   @relation("BookingInquiryCity")
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  djProfiles        DjProfile[]
  djVenues          DjVenue[]
  events            Event[]
  fanProfiles       FanProfile[]
  gigs              Gig[]
  organizerProfiles OrganizerProfile[]
  users             User[]
  venues            Venue[]

  @@unique([name, countryId])
  @@unique([id, countryId])
  @@index([countryId])
}

model User {
  id                         String                       @id
  username                   String                       @unique
  createdAt                  DateTime                     @default(now())
  cityId                     Int?
  countryId                  Int?
  deletedAt                  DateTime?
  email                      String                       @unique
  image                      String?
  imagePath                  String?
  lastLoginAt                DateTime?
  name                       String?
  onboardingComplete         Boolean                      @default(false)
  status                     UserStatus                   @default(ACTIVE)
  updatedAt                  DateTime                     @updatedAt
  adminActionLogs            AdminActionLog[]
  bookingInquiriesOrganized  BookingInquiry[]             @relation("OrganizerBookingInquiries")
  bookingInquiries           BookingInquiry[]
  bookingInquiryMessages     BookingInquiryMessage[]      @relation("BookingInquiryMessageSender")
  contactSubmissions         ContactSubmission[]
  djComments                 DjComment[]
  djCommentLikes             DjCommentLike[]
  followedDjs                DjFollow[]
  djGigReviews               DjGigReview[]
  djProfile                  DjProfile?
  moderatedDjRatings         DjRating[]                   @relation("DjRatingModerator")
  djRatings                  DjRating[]                   @relation("DjRatingAuthor")
  djRatingHelpfulVotes       DjRatingHelpfulVote[]
  emailLogs                  EmailLog[]
  emailPreference            EmailPreference?
  eventModerations           EventModeration[]            @relation("EventModerationAdmin")
  eventReviews               EventReview[]
  fanProfile                 FanProfile?
  followers                  Follower[]                   @relation("UserFollowers")
  followings                 Follower[]                   @relation("UserFollowings")
  gigReviews                 GigReview[]
  notificationsReceived      Notification[]               @relation("NotificationRecipient")
  notificationsSent          Notification[]               @relation("NotificationSender")
  organizerProfile           OrganizerProfile?
  posts                      Post[]
  postComments               PostComment[]
  postCommentLikes           PostCommentLike[]
  postLikes                  PostLike[]
  reportsSubmitted           Report[]                     @relation("ReportSubmitter")
  reportsReviewed            Report[]                     @relation("ReportReviewer")
  reviewNotificationTracking ReviewNotificationTracking[] @relation("ReviewNotificationTracking")
  savedEvents                SavedEvent[]
  city                       City?                        @relation(fields: [cityId], references: [id])
  country                    Country?                     @relation(fields: [countryId], references: [id])
  roles                      UserRole[]
  venueReviews               VenueReview[]

  @@index([status])
  @@index([deletedAt])
  @@index([countryId])
  @@index([cityId])
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model DjProfile {
  id                         Int                 @id @default(autoincrement())
  userId                     String              @unique
  stageName                  String
  slug                       String              @unique
  avatar                     String?
  avatarPath                 String?
  coverImage                 String?
  coverImagePath             String?
  bio                        String?
  experienceYears            Int?
  experienceLevel            ExperienceLevel?
  status                     DjProfileStatus     @default(PENDING_APPROVAL)
  countryId                  Int
  cityId                     Int
  plan                       DjPlan              @default(FREE)
  featured                   Boolean             @default(false)
  hidden                     Boolean             @default(false)
  searchScore                Float               @default(0)
  bookingEmail               String?
  bookingPhone               String?
  feeMin                     Int?
  feeMax                     Int?
  feeCurrency                String?
  reputationScore            Int                 @default(0)
  managerName                String?
  managerEmail               String?
  managerPhone               String?
  agentName                  String?
  agentAgency                String?
  agentEmail                 String?
  availabilityTimezone       String?
  availabilityMonth          String?
  availabilityDays           Json?
  featuredPerformanceUrl     String?
  featuredPerformanceContext String?
  monthlyViews               Int                 @default(0)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deletedAt                  DateTime?
  bookingInquiries           BookingInquiry[]    @relation("DjProfileBookingInquiries")
  highlights                 DjCareerHighlight[]
  comments                   DjComment[]
  endorsements               DjEndorsement[]
  followers                  DjFollow[]
  genres                     DjGenre[]
  djGigReviews               DjGigReview[]
  packages                   DjPackage[]
  pressItems                 DjPress[]
  city                       City                @relation(fields: [cityId], references: [id])
  country                    Country             @relation(fields: [countryId], references: [id])
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  djTypes                    DjProfileType[]
  ratings                    DjRating[]
  venues                     DjVenue[]
  eventsOwned                Event[]             @relation("EventOwner")
  events                     EventDj[]
  eventReviews               EventReview[]
  gigApplications            GigApplication[]
  gigReviews                 GigReview[]
  media                      Media[]
  organizerReviews           OrganizerReview[]
  profileViews               ProfileView[]
  reputationDetail           ReputationScore?
  socialLinks                SocialLink[]

  @@index([slug])
  @@index([status])
  @@index([hidden])
  @@index([plan])
  @@index([featured])
  @@index([searchScore])
  @@index([countryId])
  @@index([cityId])
}

model DjPackage {
  id          Int       @id @default(autoincrement())
  name        String
  priceFrom   Int
  priceTo     Int?
  currency    String    @default("USD")
  duration    String?
  features    String[]
  popular     Boolean   @default(false)
  sortOrder   Int       @default(0)
  djProfileId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([djProfileId, sortOrder])
  @@index([sortOrder])
}

model DjCareerHighlight {
  id          Int       @id @default(autoincrement())
  year        String
  title       String
  description String?
  djProfileId Int
  createdAt   DateTime  @default(now())
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([djProfileId, year])
}

model DjEndorsement {
  id          Int       @id @default(autoincrement())
  name        String
  role        String
  company     String?
  quote       String
  avatar      String?
  djProfileId Int
  createdAt   DateTime  @default(now())
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([djProfileId, createdAt])
}

model DjPress {
  id          Int       @id @default(autoincrement())
  source      String
  type        String
  title       String
  date        String?
  url         String?
  djProfileId Int
  createdAt   DateTime  @default(now())
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([djProfileId, createdAt])
}

model DjVenue {
  id          Int       @id @default(autoincrement())
  venueName   String
  eventDate   String?
  description String?
  countryId   Int
  cityId      Int
  djProfileId Int
  latitude    Float?
  longitude   Float?
  geocodedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  city        City      @relation(fields: [cityId, countryId], references: [id, countryId])
  country     Country   @relation(fields: [countryId], references: [id])
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([djProfileId, eventDate])
  @@index([countryId])
  @@index([cityId])
}

model Venue {
  id                   Int                   @id @default(autoincrement())
  name                 String
  address              String?
  countryId            Int
  cityId               Int
  latitude             Float?
  longitude            Float?
  source               String?
  externalId           String?
  popularity           Int                   @default(0)
  createdAt            DateTime              @default(now())
  city                 City                  @relation(fields: [cityId, countryId], references: [id, countryId])
  country              Country               @relation(fields: [countryId], references: [id])
  venueReputationScore VenueReputationScore?
  venueReviews         VenueReview[]

  @@unique([name, cityId])
  @@index([name])
  @@index([countryId])
}

model VenueReview {
  id            Int      @id @default(autoincrement())
  soundSystem   Int
  atmosphere    Int
  location      Int
  accessibility Int
  rating        Int
  review        String?
  venueId       Int
  eventId       Int
  userId        String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([eventId, venueId, userId])
  @@index([venueId])
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

model ProfileView {
  id          Int       @id @default(autoincrement())
  viewerId    String?
  viewerIp    String?
  source      String?
  city        String?
  country     String?
  djProfileId Int
  createdAt   DateTime  @default(now())
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([djProfileId])
  @@index([createdAt])
  @@index([viewerId])
}

model OrganizerProfile {
  id               Int                       @id @default(autoincrement())
  userId           String                    @unique
  displayName      String
  slug             String                    @unique
  organizerType    OrganizerType             @default(INDIVIDUAL)
  status           OrganizerStatus           @default(ACTIVE)
  bio              String?
  logoUrl          String?
  logoPath         String?
  coverImageUrl    String?
  coverImagePath   String?
  website          String?
  contactEmail     String?
  phone            String?
  hidden           Boolean                   @default(false)
  countryId        Int
  cityId           Int
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  gigs             Gig[]
  city             City                      @relation(fields: [cityId], references: [id])
  country          Country                   @relation(fields: [countryId], references: [id])
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reputationDetail OrganizerReputationScore?
  organizerReviews OrganizerReview[]
  socialLinks      OrganizerSocialLink[]

  @@index([slug])
  @@index([status])
  @@index([hidden])
  @@index([organizerType])
  @@index([countryId])
  @@index([cityId])
}

model OrganizerSocialLink {
  id                 Int              @id @default(autoincrement())
  organizerProfileId Int
  platform           String
  url                String
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@unique([organizerProfileId, platform])
  @@index([organizerProfileId])
}

model FanProfile {
  id         Int       @id @default(autoincrement())
  userId     String    @unique
  name       String
  avatar     String?
  avatarPath String?
  bio        String?
  countryId  Int?
  cityId     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  city       City?     @relation(fields: [cityId], references: [id])
  country    Country?  @relation(fields: [countryId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([countryId])
  @@index([cityId])
}

model Genre {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  djGenres DjGenre[]

  @@index([name])
}

model DjGenre {
  djProfileId Int
  genreId     Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  genre       Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([djProfileId, genreId])
}

model DjProfileType {
  djProfileId Int
  type        DjType
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@id([djProfileId, type])
}

model SocialLink {
  id          Int       @id @default(autoincrement())
  djProfileId Int
  platform    String
  url         String
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@unique([djProfileId, platform])
  @@index([djProfileId])
}

model Media {
  id          Int        @id @default(autoincrement())
  type        MediaType  @default(IMAGE)
  url         String
  bucket      String
  path        String
  sortOrder   Int        @default(0)
  isSpotlight Boolean    @default(false)
  title       String?
  duration    String?
  thumbnail   String?
  playCount   Int        @default(0)
  viewCount   Int        @default(0)
  djProfileId Int?
  postId      Int?
  createdAt   DateTime   @default(now())
  djProfile   DjProfile? @relation(fields: [djProfileId], references: [id])
  post        Post?      @relation(fields: [postId], references: [id])

  @@index([djProfileId])
  @@index([djProfileId, type])
  @@index([djProfileId, isSpotlight])
  @@index([postId])
  @@index([type])
  @@index([isSpotlight])
  @@index([sortOrder])
}

model DjRating {
  id               Int                    @id @default(autoincrement())
  rating           Int
  review           String?
  userId           String
  djProfileId      Int
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  eventId          Int?
  reviewType       DjRatingType?
  helpfulCount     Int                    @default(0)
  respondedAt      DateTime?
  response         String?
  moderatedAt      DateTime?
  moderatedById    String?
  moderationStatus ReviewModerationStatus @default(APPROVED)
  moderatorNote    String?
  djProfile        DjProfile              @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  event            Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  moderator        User?                  @relation("DjRatingModerator", fields: [moderatedById], references: [id])
  user             User                   @relation("DjRatingAuthor", fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes     DjRatingHelpfulVote[]

  @@unique([userId, djProfileId], map: "DjRating_userId_djProfileId_direct_unique", where: raw("(\"eventId\" IS NULL)"))
  @@unique([userId, djProfileId, eventId], map: "DjRating_userId_djProfileId_eventId_event_unique", where: raw("(\"eventId\" IS NOT NULL)"))
  @@index([djProfileId])
  @@index([djProfileId, createdAt])
  @@index([eventId])
  @@index([reviewType])
  @@index([helpfulCount])
  @@index([respondedAt])
  @@index([moderationStatus])
  @@index([moderatedById])
}

model DjRatingHelpfulVote {
  id        Int      @id @default(autoincrement())
  ratingId  Int
  userId    String
  createdAt DateTime @default(now())
  rating    DjRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ratingId, userId])
  @@index([ratingId])
  @@index([userId])
}

model DjComment {
  id          Int             @id @default(autoincrement())
  content     String
  deletedAt   DateTime?
  userId      String
  djProfileId Int
  parentId    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  djProfile   DjProfile       @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  parent      DjComment?      @relation("DjCommentReplies", fields: [parentId], references: [id])
  replies     DjComment[]     @relation("DjCommentReplies")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       DjCommentLike[]

  @@index([djProfileId])
  @@index([parentId])
  @@index([userId])
}

model DjCommentLike {
  userId    String
  commentId Int
  comment   DjComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model Post {
  id        Int           @id @default(autoincrement())
  type      PostType      @default(TEXT)
  content   String?
  deletedAt DateTime?
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  media     Media[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  PostComment[]
  likes     PostLike[]

  @@index([userId])
  @@index([createdAt])
}

model PostComment {
  id        Int               @id @default(autoincrement())
  content   String
  deletedAt DateTime?
  userId    String
  postId    Int
  parentId  Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  parent    PostComment?      @relation("PostCommentReplies", fields: [parentId], references: [id])
  replies   PostComment[]     @relation("PostCommentReplies")
  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostCommentLike[]

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  userId String
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostCommentLike {
  userId    String
  commentId Int
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model Event {
  title            String
  createdAt        DateTime          @default(now())
  audioLink        String?
  category         String            @default("OTHER")
  cityId           Int?
  countryId        Int?
  deletedAt        DateTime?
  description      String?
  endDate          DateTime?
  endTime          String?
  eventType        EventType         @default(PUBLIC)
  featured         Boolean           @default(false)
  genres           String[]
  hidden           Boolean           @default(false)
  ownerDjId        Int
  posterPath       String?
  posterUrl        String?
  recap            String?
  slug             String            @unique
  startDate        DateTime
  startTime        String?
  status           EventStatus       @default(DRAFT)
  ticketUrl        String?
  timezone         String?
  updatedAt        DateTime          @updatedAt
  venue            String?
  videoLink        String?
  viewCount        Int               @default(0)
  id               Int               @id @default(autoincrement())
  djRatings        DjRating[]
  city             City?             @relation(fields: [cityId], references: [id])
  country          Country?          @relation(fields: [countryId], references: [id])
  ownerDj          DjProfile         @relation("EventOwner", fields: [ownerDjId], references: [id])
  participants     EventDj[]
  gallery          EventMedia[]
  eventModerations EventModeration[]
  eventReviews     EventReview[]
  savedBy          SavedEvent[]
  venueReviews     VenueReview[]

  @@index([ownerDjId])
  @@index([ownerDjId, status])
  @@index([ownerDjId, status, deletedAt])
  @@index([status])
  @@index([startDate])
  @@index([featured])
  @@index([hidden])
  @@index([countryId])
  @@index([cityId])
}

model EventDj {
  eventId     Int
  djProfileId Int
  role        String?
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, djProfileId])
  @@index([djProfileId])
}

model EventMedia {
  id        Int      @id @default(autoincrement())
  eventId   Int
  url       String
  path      String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventModeration {
  id             Int                   @id @default(autoincrement())
  status         EventModerationStatus @default(PENDING)
  adminComment   String
  eventUpdatedAt DateTime
  adminId        String
  eventId        Int
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  admin          User                  @relation("EventModerationAdmin", fields: [adminId], references: [id])
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@index([adminId])
}

model Gig {
  id                      Int               @id @default(autoincrement())
  slug                    String            @unique
  organizerProfileId      Int
  title                   String
  gigType                 GigType
  description             String?
  status                  GigStatus         @default(DRAFT)
  eventDate               DateTime
  applicationDeadline     DateTime?
  countryId               Int?
  cityId                  Int?
  venueName               String?
  hideVenueName           Boolean           @default(false)
  venueAddress            String?
  venuePostalCode         String?
  budgetType              BudgetType        @default(TBA)
  budgetMin               Int?
  budgetMax               Int?
  currency                String            @default("SEK")
  requiredGenres          String[]
  requiredExperienceLevel ExperienceLevel   @default(OPEN)
  setDurationMinutes      Int?
  guestCount              Int?
  dressCode               String?
  mcRequired              Boolean           @default(false)
  micRequired             Boolean           @default(false)
  languagesSpoken         String[]
  venueProvides           String[]
  djMustBring             String[]
  arrivalInstructions     String?
  setupNotes              String?
  organizerContactName    String?
  organizerContactPhone   String?
  organizerContactEmail   String?
  viewCount               Int               @default(0)
  hidden                  Boolean           @default(false)
  deletedAt               DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  djGigReviews            DjGigReview[]
  city                    City?             @relation(fields: [cityId], references: [id])
  country                 Country?          @relation(fields: [countryId], references: [id])
  organizerProfile        OrganizerProfile  @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  applications            GigApplication[]
  gigReviews              GigReview[]
  organizerReviews        OrganizerReview[]

  @@index([status])
  @@index([gigType])
  @@index([organizerProfileId])
  @@index([eventDate])
  @@index([cityId])
  @@index([countryId])
  @@index([applicationDeadline])
  @@index([hidden])
  @@index([slug])
}

model GigApplication {
  id            Int                  @id @default(autoincrement())
  status        GigApplicationStatus @default(APPLIED)
  message       String?
  gigId         Int
  djProfileId   Int
  shortlistedAt DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  withdrawnAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  djProfile     DjProfile            @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  gig           Gig                  @relation(fields: [gigId], references: [id], onDelete: Cascade)
  hire          Hire?

  @@unique([gigId, djProfileId])
  @@index([gigId])
  @@index([djProfileId])
  @@index([status])
}

model GigReview {
  id          Int       @id @default(autoincrement())
  rating      Int
  review      String?
  gigId       Int
  djProfileId Int
  organizerId String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  gig         Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([gigId, djProfileId])
  @@index([djProfileId])
  @@index([organizerId])
  @@index([gigId])
  @@index([createdAt])
}

/// DJ review of an organizer/gig they have completed.
/// djProfileId is the reviewer (the DJ who performed the gig).
/// organizerId is the review subject (the organizer who hired the DJ).
model DjGigReview {
  id          Int       @id @default(autoincrement())
  rating      Int
  review      String?
  gigId       Int
  djProfileId Int
  organizerId String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  gig         Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([gigId, djProfileId])
  @@index([djProfileId])
  @@index([organizerId])
  @@index([gigId])
  @@index([createdAt])
}

model EventReview {
  id          Int       @id @default(autoincrement())
  rating      Int
  review      String?
  reviewType  String?
  userId      String
  eventId     Int
  djProfileId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, djProfileId])
  @@index([eventId])
  @@index([djProfileId])
  @@index([userId])
  @@index([reviewType])
}

model OrganizerReview {
  id                 Int              @id @default(autoincrement())
  communication      Int
  payment            Int
  professionalism    Int
  venueQuality       Int
  rating             Int
  review             String?
  gigId              Int
  djProfileId        Int
  organizerProfileId Int
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  djProfile          DjProfile        @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  gig                Gig              @relation(fields: [gigId], references: [id], onDelete: Cascade)
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@unique([gigId, djProfileId])
  @@index([djProfileId])
  @@index([organizerProfileId])
  @@index([gigId])
  @@index([createdAt])
}

model ResponseTemplate {
  id         String                   @id @default(cuid())
  name       String
  category   ResponseTemplateCategory
  content    String
  variables  String[]
  isDefault  Boolean                  @default(false)
  usageCount Int                      @default(0)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([category])
  @@index([isDefault])
}

model ReputationScore {
  id                  Int                 @id @default(autoincrement())
  djProfileId         Int                 @unique
  totalScore          Int                 @default(0)
  profileQualityScore Int                 @default(0)
  verificationScore   Int                 @default(0)
  reviewScore         Int                 @default(0)
  reliabilityScore    Int                 @default(0)
  activityScore       Int                 @default(0)
  newTalentBoost      Int                 @default(0)
  confidenceLevel     Float               @default(0)
  trendDirection      String              @default("STABLE")
  calculatedAt        DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  reputationHistories ReputationHistory[]
  djProfile           DjProfile           @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@index([djProfileId])
}

model OrganizerReputationScore {
  id                  Int                          @id @default(autoincrement())
  organizerProfileId  Int                          @unique
  totalScore          Int                          @default(0)
  profileQualityScore Int                          @default(0)
  verificationScore   Int                          @default(0)
  reviewScore         Int                          @default(0)
  reliabilityScore    Int                          @default(0)
  activityScore       Int                          @default(0)
  confidenceLevel     Float                        @default(0)
  trendDirection      String                       @default("STABLE")
  calculatedAt        DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  reputationHistories OrganizerReputationHistory[]
  organizerProfile    OrganizerProfile             @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@index([organizerProfileId])
}

model ReputationHistory {
  id                Int                    @id @default(autoincrement())
  reputationScoreId Int
  previousTotal     Int
  newTotal          Int
  createdAt         DateTime               @default(now())
  changeReason      ReputationChangeReason
  reputationScore   ReputationScore        @relation(fields: [reputationScoreId], references: [id], onDelete: Cascade)

  @@index([reputationScoreId])
  @@index([createdAt])
}

model OrganizerReputationHistory {
  id                         Int                      @id @default(autoincrement())
  organizerReputationScoreId Int
  previousTotal              Int
  newTotal                   Int
  createdAt                  DateTime                 @default(now())
  changeReason               ReputationChangeReason
  organizerReputationScore   OrganizerReputationScore @relation(fields: [organizerReputationScoreId], references: [id], onDelete: Cascade)

  @@index([organizerReputationScoreId])
  @@index([createdAt])
}

model VenueReputationScore {
  id                  Int                      @id @default(autoincrement())
  venueId             Int                      @unique
  totalScore          Int                      @default(0)
  profileQualityScore Int                      @default(0)
  verificationScore   Int                      @default(0)
  reviewScore         Int                      @default(0)
  reliabilityScore    Int                      @default(0)
  activityScore       Int                      @default(0)
  confidenceLevel     Float                    @default(0)
  trendDirection      String                   @default("STABLE")
  calculatedAt        DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  reputationHistories VenueReputationHistory[]
  venue               Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@index([venueId])
}

model VenueReputationHistory {
  id                     Int                    @id @default(autoincrement())
  venueReputationScoreId Int
  previousTotal          Int
  newTotal               Int
  changeReason           ReputationChangeReason
  createdAt              DateTime               @default(now())
  venueReputationScore   VenueReputationScore   @relation(fields: [venueReputationScoreId], references: [id], onDelete: Cascade)

  @@index([venueReputationScoreId])
  @@index([createdAt])
}

model Follower {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowings", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model DjFollow {
  userId      String
  djProfileId Int
  createdAt   DateTime  @default(now())
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, djProfileId])
  @@index([userId])
  @@index([djProfileId])
}

model SavedEvent {
  userId    String
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  read        Boolean          @default(false)
  data        Json?
  emailSentAt DateTime?
  recipientId String
  senderId    String?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model ReviewNotificationTracking {
  id          Int       @id @default(autoincrement())
  userId      String
  targetType  String
  targetId    Int
  notifiedAt  DateTime  @default(now())
  remindedAt  DateTime?
  dismissedAt DateTime?
  user        User      @relation("ReviewNotificationTracking", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

model EmailPreference {
  id                  Int     @id @default(autoincrement())
  userId              String  @unique
  bookingEmails       Boolean @default(true)
  gigEmails           Boolean @default(true)
  applicationEmails   Boolean @default(true)
  profileReviewEmails Boolean @default(true)
  platformUpdates     Boolean @default(true)
  marketingEmails     Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id                Int            @id @default(autoincrement())
  userId            String?
  recipientEmail    String
  emailType         EmailType
  provider          String         @default("resend")
  status            EmailLogStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  retryCount        Int            @default(0)
  lastAttemptAt     DateTime       @default(now())
  createdAt         DateTime       @default(now())
  user              User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([emailType])
  @@index([createdAt])
}

model ContactSubmission {
  id        Int             @id @default(autoincrement())
  name      String
  email     String
  category  ContactCategory
  message   String
  userId    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([category])
  @@index([createdAt])
}

model Report {
  id           Int              @id @default(autoincrement())
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  description  String?
  status       ReportStatus     @default(OPEN)
  adminNote    String?
  reporterId   String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reporter     User             @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("ReportReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reviewedById])
}

model AdminActionLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String
  targetId   String
  metadata   Json?
  adminId    String?
  createdAt  DateTime @default(now())
  admin      User?    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId Int
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  readAt         DateTime?
  conversationId Int
  senderId       String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model EventAttendance {
  eventId Int
  userId  String
  status  AttendanceStatus

  @@id([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Hire {
  id                 Int            @id @default(autoincrement())
  applicationId      Int            @unique
  agreedRate         Decimal?
  notes              String?
  status             HireStatus     @default(ACTIVE)
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  noShow             Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  application        GigApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

