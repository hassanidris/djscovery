// ============================================================
// SECTION 1: MVP MODELS
// ============================================================

// ------ GEOGRAPHY ------

model Country {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  code              String             @unique // ISO 3166-1 alpha-2, e.g. "SE"
  cities            City[]
  users             User[]
  djProfiles        DjProfile[]
  organizerProfiles OrganizerProfile[]
  events            Event[]
  gigs              Gig[]
  fanProfiles       FanProfile[]
  bookingInquiries  BookingInquiry[]   @relation("BookingInquiryCountry")
  djVenues          DjVenue[]
  venues            Venue[]

  @@index([name])
}

model City {
  id                Int                @id @default(autoincrement())
  name              String
  countryId         Int
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  users             User[]
  djProfiles        DjProfile[]
  organizerProfiles OrganizerProfile[]
  events            Event[]
  gigs              Gig[]
  fanProfiles       FanProfile[]
  bookingInquiries  BookingInquiry[]   @relation("BookingInquiryCity")
  djVenues          DjVenue[]
  venues            Venue[]

  @@unique([name, countryId])
  @@unique([id, countryId])
  @@index([countryId])
}

// ------ USER ------

model User {
  id                 String     @id // Must match Supabase Auth user id
  email              String     @unique
  username           String     @unique
  name               String?
  image              String?
  imagePath          String?
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  onboardingComplete Boolean    @default(false)
  lastLoginAt        DateTime?

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])

  roles                     UserRole[]
  djProfile                 DjProfile?
  organizerProfile          OrganizerProfile?
  fanProfile                FanProfile?
  emailPreference           EmailPreference?
  emailLogs                 EmailLog[]
  contactSubmissions        ContactSubmission[]
  bookingInquiriesOrganized BookingInquiry[]        @relation("OrganizerBookingInquiries")
  bookingInquiryMessages    BookingInquiryMessage[] @relation("BookingInquiryMessageSender")

  posts            Post[]
  postComments     PostComment[]
  postLikes        PostLike[]
  postCommentLikes PostCommentLike[]

  djComments     DjComment[]
  djCommentLikes DjCommentLike[]
  djRatings      DjRating[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")

  followers  Follower[] @relation("UserFollowers")
  followings Follower[] @relation("UserFollowings")

  followedDjs DjFollow[]
  savedEvents SavedEvent[]

  reportsSubmitted Report[]          @relation("ReportSubmitter")
  reportsReviewed  Report[]          @relation("ReportReviewer")
  adminActionLogs  AdminActionLog[]
  eventModerations EventModeration[] @relation("EventModerationAdmin")

  gigReviews       GigReview[]
  eventReviews     EventReview[]
  bookingInquiries BookingInquiry[]
  venueReviews     VenueReview[]
  djGigReviews     DjGigReview[]

  @@index([status])
  @@index([deletedAt])
  @@index([countryId])
  @@index([cityId])
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

// ------ DJ PROFILE ------

// Admin must approve before profile is publicly visible.
// DJs can still edit while PENDING_APPROVAL.
model DjProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stageName       String
  slug            String           @unique // URL-friendly: /djs/[slug]
  avatar          String? // Supabase Storage public URL
  avatarPath      String? // Supabase Storage path (for deletion on re-upload)
  coverImage      String? // Supabase Storage public URL
  coverImagePath  String? // Supabase Storage path (for deletion on re-upload)
  bio             String?
  experienceYears Int?
  experienceLevel ExperienceLevel?
  status          DjProfileStatus  @default(PENDING_APPROVAL)

  countryId Int
  country   Country @relation(fields: [countryId], references: [id])
  cityId    Int
  city      City    @relation(fields: [cityId], references: [id])

  plan         DjPlan  @default(FREE)
  featured     Boolean @default(false)
  hidden       Boolean @default(false) // Admin can hide without changing approval status
  searchScore  Float   @default(0)
  bookingEmail String?
  bookingPhone String?
  feeMin       Int?
  feeMax       Int?
  feeCurrency  String?

  reputationScore Int @default(0) // 0-1000, denormalized for fast search

  // Premium: Team contacts
  managerName  String?
  managerEmail String?
  managerPhone String?
  agentName    String?
  agentAgency  String?
  agentEmail   String?

  // Premium: Availability calendar
  availabilityTimezone String?
  availabilityMonth    String? // e.g. "2025-09"
  availabilityDays     Json? // [{day: 1, status: "available"}, ...]

  // Premium: Featured performance (YouTube only)
  featuredPerformanceUrl     String?
  featuredPerformanceContext String?

  // Premium: Analytics (denormalized)
  monthlyViews Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  genres           DjGenre[]
  djTypes          DjProfileType[]
  socialLinks      SocialLink[]
  ratings          DjRating[]
  comments         DjComment[]
  media            Media[]
  events           EventDj[]
  eventsOwned      Event[]             @relation("EventOwner")
  gigApplications  GigApplication[]
  followers        DjFollow[]
  gigReviews       GigReview[]
  eventReviews     EventReview[]
  reputationDetail ReputationScore?
  bookingInquiries BookingInquiry[]    @relation("DjProfileBookingInquiries")
  packages         DjPackage[]
  highlights       DjCareerHighlight[]
  endorsements     DjEndorsement[]
  pressItems       DjPress[]
  profileViews     ProfileView[]
  venues           DjVenue[]
  organizerReviews OrganizerReview[]
  djGigReviews     DjGigReview[]

  @@index([slug])
  @@index([status])
  @@index([hidden])
  @@index([plan])
  @@index([featured])
  @@index([searchScore])
  @@index([countryId])
  @@index([cityId])
}

// ------ DJ PREMIUM: PACKAGES ------

model DjPackage {
  id        Int      @id @default(autoincrement())
  name      String
  priceFrom Int
  priceTo   Int?
  currency  String   @default("USD")
  duration  String?
  features  String[]
  popular   Boolean  @default(false)
  sortOrder Int      @default(0)

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djProfileId])
  @@index([djProfileId, sortOrder])
  @@index([sortOrder])
}

// ------ DJ PREMIUM: CAREER HIGHLIGHTS ------

model DjCareerHighlight {
  id          Int     @id @default(autoincrement())
  year        String
  title       String
  description String?

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([djProfileId, year])
}

// ------ DJ PREMIUM: ENDORSEMENTS ------

model DjEndorsement {
  id      Int     @id @default(autoincrement())
  name    String
  role    String
  company String?
  quote   String
  avatar  String?

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([djProfileId, createdAt])
}

// ------ DJ PREMIUM: PRESS & MEDIA ------

model DjPress {
  id     Int     @id @default(autoincrement())
  source String
  type   String // Feature, Interview, Podcast
  title  String
  date   String?
  url    String?

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([djProfileId, createdAt])
}

// ------ DJ PREMIUM: WHERE I'VE PLAYED (VENUES) ------

model DjVenue {
  id          Int     @id @default(autoincrement())
  venueName   String
  eventDate   String? // YYYY-MM format or full date
  description String?

  countryId Int
  country   Country @relation(fields: [countryId], references: [id])
  cityId    Int
  city      City    @relation(fields: [cityId, countryId], references: [id, countryId])

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  latitude   Float?
  longitude  Float?
  geocodedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djProfileId])
  @@index([djProfileId, eventDate])
  @@index([countryId])
  @@index([cityId])
}

// ------ VENUE DATABASE (FOR AUTOCOMPLETE) ------

model Venue {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  countryId  Int
  country    Country  @relation(fields: [countryId], references: [id])
  cityId     Int
  city       City     @relation(fields: [cityId, countryId], references: [id, countryId])
  latitude   Float?
  longitude  Float?
  source     String? // 'manual', 'mapbox', 'osm'
  externalId String? // Mapbox/OSM place ID
  popularity Int      @default(0) // Track usage for ranking
  createdAt  DateTime @default(now())

  venueReviews         VenueReview[]
  venueReputationScore VenueReputationScore?

  @@unique([name, cityId])
  @@index([name])
  @@index([countryId])
}

model VenueReview {
  id Int @id @default(autoincrement())

  // Category ratings (1-5)
  soundSystem   Int
  atmosphere    Int
  location      Int
  accessibility Int

  // Overall rating (1-5) - calculated from categories
  rating Int

  review String?

  venueId Int
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventId Int
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Anti-gaming audit
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, venueId, userId]) // one review per event per venue per user
  @@index([venueId])
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

// ------ DJ ANALYTICS: PROFILE VIEWS ------

model ProfileView {
  id       Int     @id @default(autoincrement())
  viewerId String? // user id if logged in
  viewerIp String?
  source   String? // direct, search, social, referral
  city     String?
  country  String?

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([createdAt])
  @@index([viewerId])
}

// ------ ORGANIZER PROFILE ------

model OrganizerProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String

  slug          String          @unique // /organizers/[slug]
  organizerType OrganizerType   @default(INDIVIDUAL)
  status        OrganizerStatus @default(ACTIVE)

  bio            String?
  logoUrl        String? // Supabase Storage: org-avatar bucket public URL
  logoPath       String? // Supabase Storage: org-avatar bucket object path (for deletion)
  coverImageUrl  String? // Supabase Storage: org-cover bucket public URL
  coverImagePath String? // Supabase Storage: org-cover bucket object path (for deletion)
  website        String?
  contactEmail   String? // PRIVATE — never rendered publicly
  phone          String?
  hidden         Boolean @default(false) // Admin can hide without suspending

  countryId Int
  country   Country @relation(fields: [countryId], references: [id])
  cityId    Int
  city      City    @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  socialLinks      OrganizerSocialLink[]
  gigs             Gig[]
  organizerReviews OrganizerReview[]
  reputationDetail OrganizerReputationScore?

  @@index([slug])
  @@index([status])
  @@index([hidden])
  @@index([organizerType])
  @@index([countryId])
  @@index([cityId])
}

// ------ ORGANIZER SOCIAL LINKS ------

// platform values: "instagram" | "linkedin" | "facebook" | "tiktok" | "youtube" | "website"
model OrganizerSocialLink {
  id                 Int              @id @default(autoincrement())
  organizerProfileId Int
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  platform           String
  url                String

  @@unique([organizerProfileId, platform])
  @@index([organizerProfileId])
}

// ------ FAN PROFILE ------

model FanProfile {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  avatar     String? // Supabase Storage public URL
  avatarPath String? // Supabase Storage path (for deletion on re-upload)
  bio        String?

  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([countryId])
  @@index([cityId])
}

// ------ GENRES ------

// Admin-managed list of genres
model Genre {
  id       Int       @id @default(autoincrement())
  name     String    @unique // e.g. "Afrobeat", "House", "Amapiano"
  djGenres DjGenre[]

  @@index([name])
}

model DjGenre {
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  genreId     Int
  genre       Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([djProfileId, genreId])
}

model DjProfileType {
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  type        DjType

  @@id([djProfileId, type])
}

// ------ SOCIAL LINKS ------

// platform values: "instagram" | "tiktok" | "youtube" | "spotify" | "soundcloud" | "mixcloud" | "website"
// UI renders icon based on platform string
model SocialLink {
  id          Int       @id @default(autoincrement())
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  platform    String
  url         String

  @@unique([djProfileId, platform])
  @@index([djProfileId])
}

// ------ MEDIA ------

// Supports IMAGE (file upload), VIDEO (external URL), AUDIO (external URL)
// Supabase Storage bucket: "djscovery-media"
model Media {
  id          Int       @id @default(autoincrement())
  type        MediaType @default(IMAGE)
  url         String // Supabase Storage public URL or external URL
  bucket      String // Supabase Storage bucket name or "external"
  path        String // Supabase Storage path within bucket or original URL
  sortOrder   Int       @default(0) // For reordering in gallery
  isSpotlight Boolean   @default(false) // Marked for spotlight section (max 2)
  title       String? // Auto-fetched from oEmbed for video/audio
  duration    String? // Auto-fetched from oEmbed (e.g. "3:45")
  thumbnail   String? // Auto-fetched from oEmbed for video/audio
  playCount   Int       @default(0) // AUDIO: unique plays (deduped per viewer per day)
  viewCount   Int       @default(0) // VIDEO: unique views (deduped per viewer per day)

  djProfileId Int?
  djProfile   DjProfile? @relation(fields: [djProfileId], references: [id], onDelete: SetNull)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([djProfileId])
  @@index([djProfileId, type])
  @@index([djProfileId, isSpotlight])
  @@index([postId])
  @@index([type])
  @@index([isSpotlight])
  @@index([sortOrder])
}

// ------ DJ RATINGS ------

// Supports both direct reviews (eventId = null) and event-anchored reviews (eventId != null)
// One direct review per user per DJ, one event review per user per event per DJ
// Partial unique indexes are created via raw SQL migration to handle NULL eventId correctly
model DjRating {
  id     Int     @id @default(autoincrement())
  rating Int // 1-5
  review String?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  // Event-anchored review support
  eventId    Int?
  event      Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewType DjRatingType? // DIRECT, EVENT_ATTENDEE, EVENT_ORGANIZER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djProfileId])
  @@index([djProfileId, createdAt])
  @@index([eventId])
  @@index([reviewType])
}

// ------ DJ PROFILE COMMENTS ------

// Allowed roles: FAN, DJ, ORGANIZER
// Self-referencing for replies (parentId)
model DjComment {
  id        Int       @id @default(autoincrement())
  content   String
  deletedAt DateTime?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   DjComment?  @relation("DjCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  DjComment[] @relation("DjCommentReplies")

  likes DjCommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([djProfileId])
  @@index([parentId])
  @@index([userId])
}

model DjCommentLike {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId Int
  comment   DjComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ------ COMMUNITY FEED ------

// Only DJs can create posts (enforce in app layer)
model Post {
  id        Int       @id @default(autoincrement())
  type      PostType  @default(TEXT)
  content   String?
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments PostComment[]
  likes    PostLike[]
  media    Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// Self-referencing for replies
model PostComment {
  id        Int       @id @default(autoincrement())
  content   String
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  PostComment[] @relation("PostCommentReplies")

  likes PostCommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model PostCommentLike {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId Int
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ------ EVENTS ------

// Only DJs create events. Owner DJ controls the event.
model Event {
  id          Int         @id @default(autoincrement())
  slug        String      @unique // URL-friendly: /events/[slug]
  title       String
  description String?
  eventType   EventType   @default(PUBLIC)
  category    String      @default("OTHER") // App-layer validated against VALID_EVENT_CATEGORIES
  posterUrl   String? // Supabase Storage public URL (renamed from image)
  posterPath  String? // Supabase Storage path (for deletion on re-upload)
  venue       String?
  startDate   DateTime
  endDate     DateTime?
  startTime   String? // e.g. "22:00" — local to event timezone
  endTime     String? // e.g. "05:00"
  timezone    String? // e.g. "Europe/Stockholm"
  ticketUrl   String? // PUBLIC events only
  recap       String? // Post-event write-up (unlocked after COMPLETED)
  audioLink   String? // External URL: SoundCloud / Mixcloud
  videoLink   String? // External URL: YouTube / Vimeo (Premium only)
  featured    Boolean     @default(false) // DJ pins as Featured Performance (max 3)
  viewCount   Int         @default(0)
  genres      String[] // e.g. ["Afro House", "Melodic Techno"]
  status      EventStatus @default(DRAFT)
  hidden      Boolean     @default(false) // Admin can hide without changing status
  deletedAt   DateTime?

  ownerDjId Int
  ownerDj   DjProfile @relation("EventOwner", fields: [ownerDjId], references: [id])
  countryId Int?
  country   Country?  @relation(fields: [countryId], references: [id])
  cityId    Int?
  city      City?     @relation(fields: [cityId], references: [id])

  participants EventDj[]
  gallery      EventMedia[]
  savedBy      SavedEvent[]

  eventReviews     EventReview[]
  eventModerations EventModeration[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  venueReviews VenueReview[]
  djRatings    DjRating[]

  @@index([ownerDjId])
  @@index([ownerDjId, status])
  @@index([ownerDjId, status, deletedAt])
  @@index([status])
  @@index([startDate])
  @@index([featured])
  @@index([hidden])
  @@index([countryId])
  @@index([cityId])
}

// Junction: multiple DJs per event (co-performers)
model EventDj {
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  role        String? // e.g. "Headliner", "Support", "B2B"

  @@id([eventId, djProfileId])
  @@index([djProfileId])
}

// Gallery photos uploaded after event is COMPLETED
model EventMedia {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String // Supabase Storage public URL
  path      String // Supabase Storage path (for deletion)
  caption   String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([eventId])
}

// Admin moderation requests for events
model EventModeration {
  id             Int                   @id @default(autoincrement())
  status         EventModerationStatus @default(PENDING)
  adminComment   String // Admin's feedback on what needs editing
  eventUpdatedAt DateTime // Event's updatedAt when moderation was created (to verify edits)

  adminId String
  admin   User   @relation("EventModerationAdmin", fields: [adminId], references: [id])

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([adminId])
}

// ------ GIGS MARKETPLACE ------

model Gig {
  id   Int    @id @default(autoincrement())
  slug String @unique

  organizerProfileId Int
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  title               String
  gigType             GigType
  description         String?
  status              GigStatus @default(DRAFT)
  eventDate           DateTime
  applicationDeadline DateTime?

  // Location (city/country always visible; address/venue revealed only after acceptance)
  countryId       Int?
  country         Country? @relation(fields: [countryId], references: [id])
  cityId          Int?
  city            City?    @relation(fields: [cityId], references: [id])
  venueName       String?
  hideVenueName   Boolean  @default(false)
  venueAddress    String? // PRIVATE — revealed to accepted DJ only
  venuePostalCode String? // PRIVATE — revealed to accepted DJ only

  // Budget
  budgetType BudgetType @default(TBA)
  budgetMin  Int?
  budgetMax  Int?
  currency   String     @default("SEK")

  // Requirements
  requiredGenres          String[]
  requiredExperienceLevel ExperienceLevel @default(OPEN)
  setDurationMinutes      Int?
  guestCount              Int?
  dressCode               String?
  mcRequired              Boolean         @default(false)
  micRequired             Boolean         @default(false)
  languagesSpoken         String[]

  // Equipment (bounded multi-select; values enforced by app layer)
  venueProvides String[]
  djMustBring   String[]

  // Logistics (PRIVATE — revealed to accepted DJ only)
  arrivalInstructions   String?
  setupNotes            String?
  organizerContactName  String?
  organizerContactPhone String?
  organizerContactEmail String?

  viewCount Int       @default(0)
  hidden    Boolean   @default(false) // Admin can hide without cancelling
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  applications     GigApplication[]
  gigReviews       GigReview[]
  djGigReviews     DjGigReview[]
  organizerReviews OrganizerReview[]

  @@index([status])
  @@index([gigType])
  @@index([organizerProfileId])
  @@index([eventDate])
  @@index([cityId])
  @@index([countryId])
  @@index([applicationDeadline])
  @@index([hidden])
  @@index([slug])
}

model GigApplication {
  id      Int                  @id @default(autoincrement())
  status  GigApplicationStatus @default(APPLIED)
  message String?

  gigId Int
  gig   Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  hire Hire?

  shortlistedAt DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  withdrawnAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, djProfileId])
  @@index([gigId])
  @@index([djProfileId])
  @@index([status])
}

model GigReview {
  id     Int     @id @default(autoincrement())
  rating Int // 1-5
  review String?

  gigId       Int
  gig         Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  // Anti-gaming audit
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, djProfileId]) // one review per gig per DJ
  @@index([djProfileId])
  @@index([organizerId])
  @@index([gigId])
  @@index([createdAt])
}

/// DJ review of an organizer/gig they have completed.
/// djProfileId is the reviewer (the DJ who performed the gig).
/// organizerId is the review subject (the organizer who hired the DJ).
model DjGigReview {
  id     Int     @id @default(autoincrement())
  rating Int // 1-5
  review String?

  gigId       Int
  gig         Gig       @relation(fields: [gigId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  // Anti-gaming audit
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, djProfileId]) // one review per gig per DJ
  @@index([djProfileId])
  @@index([organizerId])
  @@index([gigId])
  @@index([createdAt])
}

model EventReview {
  id         Int     @id @default(autoincrement())
  rating     Int // 1-5
  review     String?
  reviewType String? // "ATTENDEE" or "GIG_OWNER"

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId, djProfileId])
  @@index([eventId])
  @@index([djProfileId])
  @@index([userId])
  @@index([reviewType])
}

model OrganizerReview {
  id Int @id @default(autoincrement())

  // Category ratings (1-5)
  communication   Int
  payment         Int
  professionalism Int
  venueQuality    Int

  // Overall rating (1-5) - calculated from categories
  rating Int

  review String?

  gigId              Int
  gig                Gig              @relation(fields: [gigId], references: [id], onDelete: Cascade)
  djProfileId        Int
  djProfile          DjProfile        @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  organizerProfileId Int
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  // Anti-gaming audit
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gigId, djProfileId]) // one review per gig per DJ
  @@index([djProfileId])
  @@index([organizerProfileId])
  @@index([gigId])
  @@index([createdAt])
}

model ReputationScore {
  id          Int       @id @default(autoincrement())
  djProfileId Int       @unique
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)

  totalScore          Int @default(0) // 0-1000
  profileQualityScore Int @default(0) // 0-150
  verificationScore   Int @default(0) // 0-50
  reviewScore         Int @default(0) // 0-550
  reliabilityScore    Int @default(0) // 0-150
  activityScore       Int @default(0) // 0-100
  newTalentBoost      Int @default(0) // 0-50

  confidenceLevel Float  @default(0) // 0.0-1.0
  trendDirection  String @default("STABLE") // RISING, STABLE, FALLING

  calculatedAt        DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  reputationHistories ReputationHistory[]

  @@index([totalScore])
  @@index([djProfileId])
}

model OrganizerReputationScore {
  id                 Int              @id @default(autoincrement())
  organizerProfileId Int              @unique
  organizerProfile   OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  totalScore          Int @default(0) // 0-1000
  profileQualityScore Int @default(0) // 0-150
  verificationScore   Int @default(0) // 0-50
  reviewScore         Int @default(0) // 0-550
  reliabilityScore    Int @default(0) // 0-150
  activityScore       Int @default(0) // 0-100

  confidenceLevel Float  @default(0) // 0.0-1.0
  trendDirection  String @default("STABLE") // RISING, STABLE, FALLING

  calculatedAt        DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  reputationHistories OrganizerReputationHistory[]

  @@index([totalScore])
  @@index([organizerProfileId])
}

model ReputationHistory {
  id                Int             @id @default(autoincrement())
  reputationScoreId Int
  reputationScore   ReputationScore @relation(fields: [reputationScoreId], references: [id], onDelete: Cascade)

  previousTotal Int
  newTotal      Int
  changeReason  ReputationChangeReason

  createdAt DateTime @default(now())

  @@index([reputationScoreId])
  @@index([createdAt])
}

model OrganizerReputationHistory {
  id                         Int                      @id @default(autoincrement())
  organizerReputationScoreId Int
  organizerReputationScore   OrganizerReputationScore @relation(fields: [organizerReputationScoreId], references: [id], onDelete: Cascade)

  previousTotal Int
  newTotal      Int
  changeReason  ReputationChangeReason

  createdAt DateTime @default(now())

  @@index([organizerReputationScoreId])
  @@index([createdAt])
}

model VenueReputationScore {
  id      Int   @id @default(autoincrement())
  venueId Int   @unique
  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  totalScore          Int @default(0) // 0-1000
  profileQualityScore Int @default(0) // 0-150
  verificationScore   Int @default(0) // 0-50
  reviewScore         Int @default(0) // 0-550
  reliabilityScore    Int @default(0) // 0-150
  activityScore       Int @default(0) // 0-100

  confidenceLevel Float  @default(0) // 0.0-1.0
  trendDirection  String @default("STABLE") // RISING, STABLE, FALLING

  calculatedAt        DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  reputationHistories VenueReputationHistory[]

  @@index([totalScore])
  @@index([venueId])
}

model VenueReputationHistory {
  id                     Int                  @id @default(autoincrement())
  venueReputationScoreId Int
  venueReputationScore   VenueReputationScore @relation(fields: [venueReputationScoreId], references: [id], onDelete: Cascade)

  previousTotal Int
  newTotal      Int
  changeReason  ReputationChangeReason

  createdAt DateTime @default(now())

  @@index([venueReputationScoreId])
  @@index([createdAt])
}

// ------ FOLLOWERS ------

model Follower {
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowings", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

// ------ DJ FOLLOWS ------

model DjFollow {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  djProfileId Int
  djProfile   DjProfile @relation(fields: [djProfileId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([userId, djProfileId])
  @@index([userId])
  @@index([djProfileId])
}

// ------ SAVED EVENTS ------

model SavedEvent {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ------ NOTIFICATIONS ------

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  read        Boolean          @default(false)
  data        Json? // flexible payload (postId, djProfileId, gigId, etc.)
  emailSentAt DateTime?

  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // senderId is null for system-generated notifications
  senderId String?
  sender   User?   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

// ------ EMAIL PREFERENCES ------

model EmailPreference {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingEmails       Boolean @default(true)
  gigEmails           Boolean @default(true)
  applicationEmails   Boolean @default(true)
  profileReviewEmails Boolean @default(true)
  platformUpdates     Boolean @default(true)
  marketingEmails     Boolean @default(false)
  // verificationEmails, passwordReset, securityAlerts cannot be disabled (enforced app-layer)

  @@index([userId])
}

// ------ EMAIL LOG ------

model EmailLog {
  id                Int            @id @default(autoincrement())
  userId            String? // null = system email (no user associated)
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientEmail    String
  emailType         EmailType
  provider          String         @default("resend")
  status            EmailLogStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  retryCount        Int            @default(0)
  lastAttemptAt     DateTime       @default(now())
  createdAt         DateTime       @default(now())

  @@index([userId])
  @@index([status])
  @@index([emailType])
  @@index([createdAt])
}

// ------ CONTACT SUBMISSIONS ------

model ContactSubmission {
  id        Int             @id @default(autoincrement())
  name      String
  email     String
  category  ContactCategory
  message   String
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([email])
  @@index([category])
  @@index([createdAt])
}

// ------ REPORTS ------

model Report {
  id          Int              @id @default(autoincrement())
  targetType  ReportTargetType
  targetId    String // Stringified — works for Int and String PKs
  reason      ReportReason
  description String?
  status      ReportStatus     @default(OPEN)
  adminNote   String?

  reporterId String
  reporter   User   @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reviewedById])
}

// ------ ADMIN ACTION LOG ------

// Audit trail — every admin mutation writes one row here.
model AdminActionLog {
  id         Int    @id @default(autoincrement())
  action     String // e.g. "SUSPEND_USER", "APPROVE_DJ", "HIDE_GIG"
  targetType String // e.g. "User", "DjProfile", "Gig"
  targetId   String // Stringified PK of the affected record
  metadata   Json? // Extra context: reason, note, previous status

  adminId String?
  admin   User?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================
// SECTION 2: PHASE 2 MODELS
// (Schema defined, development deferred)
// ============================================================

// ------ DIRECT MESSAGING ------

enum AttendanceStatus {
  INTERESTED
  GOING
  ATTENDED
}

// Supports DJ <-> Organizer, Fan <-> DJ, DJ <-> DJ
model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id      Int       @id @default(autoincrement())
  content String
  readAt  DateTime?

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ------ EVENT ATTENDANCE ------

model EventAttendance {
  eventId Int
  userId  String
  status  AttendanceStatus

  @@id([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// ------ HIRE RECORDS ------

// Created automatically when a GigApplication is ACCEPTED
model Hire {
  id                 Int            @id @default(autoincrement())
  applicationId      Int            @unique
  application        GigApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agreedRate         Decimal?
  notes              String?
  status             HireStatus     @default(ACTIVE)
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  noShow             Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([applicationId])
}

